{
  "manifest_version": 2,
  "name": "Teilefinder – Fahrradteile vergleichen",
  "version": "0.8.16",
  "description": "Vergleicht Fahrradteile in vier Shops direkt in deinem Browser. Ohne lokalen Server.",
  "browser_specific_settings": {
    "gecko": {
      "id": "r2-teilefinder@local.invalid",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "searchTerms",
          "websiteActivity"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "https://r2-bike.com/*",
    "https://www.r2-bike.com/*",
    "https://www.bike24.de/*",
    "https://www.bike-discount.de/*",
    "https://www.bike-components.de/*",
    "storage",
    "clipboardWrite",
    "declarativeNetRequest"
  ],
  "background": {
    "scripts": [
      "platform/api.js",
      "platform/registry.js",
      "platform/background.js"
    ]
  },
  "browser_action": {
    "default_title": "Teilefinder öffnen",
    "default_icon": "assets/icon.svg"
  },
  "content_scripts": [
    {
      "matches": [
        "https://r2-bike.com/*",
        "https://www.r2-bike.com/*",
        "https://www.bike24.de/*",
        "https://www.bike-discount.de/*",
        "https://www.bike-components.de/*"
      ],
      "js": [
        "platform/api.js",
        "platform/content.js",
        "core/products.js",
        "core/variant-match.js",
        "shops/extract.js",
        "core/suggestions.js",
        "shops/variants.js",
        "core/wishlist.js",
        "shops/reader.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "48": "assets/icon.svg",
    "96": "assets/icon.svg"
  }
}
