{
  "name": "teilefinder-extension-tools",
  "private": true,
  "scripts": {
    "build": "python3 scripts/build-extension.py",
    "test": "python3 scripts/build-extension.py --test-only",
    "build:firefox": "python3 scripts/build-extension.py --browser firefox",
    "build:chrome": "python3 scripts/build-extension.py --browser chrome",
    "lint:extension": "web-ext lint --source-dir outputs/firefox-addon --warnings-as-errors",
    "lint:chrome": "python3 scripts/build-extension.py --browser chrome --validate-only"
  },
  "devDependencies": {
    "web-ext": "^10.7.0"
  }
}
